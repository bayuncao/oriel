# 一輪中途崩潰：寫出 boom 後以 3 結束（真機上錄不出來，K05）。
{"client":{"id":1,"method":"initialize","params":{"protocolVersion":1}}}
{"agent":{"jsonrpc":"2.0","id":1,"result":{"protocolVersion":1,"agentCapabilities":{"loadSession":true}}}}
{"client":{"id":2,"method":"session/new","params":{"cwd":"<cwd>","mcpServers":[]}}}
{"agent":{"jsonrpc":"2.0","id":2,"result":{"sessionId":"<session>"}}}
{"client":{"id":3,"method":"session/prompt","params":{"sessionId":"<session>","prompt":[{"type":"text","text":"Reply with exactly one word: pong. Do not use any tools."}]}}}
{"agent":{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"<session>","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"po"}}}}}
{"stderr":"boom"}
{"exit":3}
