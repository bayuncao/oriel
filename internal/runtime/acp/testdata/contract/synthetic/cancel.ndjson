# 輸出開始後取消，agent 回 cancelled。
{"client":{"id":1,"method":"initialize","params":{"protocolVersion":1}}}
{"agent":{"jsonrpc":"2.0","id":1,"result":{"protocolVersion":1,"agentCapabilities":{"loadSession":true}}}}
{"client":{"id":2,"method":"session/new","params":{"cwd":"<cwd>","mcpServers":[]}}}
{"agent":{"jsonrpc":"2.0","id":2,"result":{"sessionId":"<session>"}}}
{"client":{"id":3,"method":"session/prompt","params":{"sessionId":"<session>","prompt":[{"type":"text","text":"Write the numbers from 1 to 400, one per line, with no other text. Do not use any tools."}]}}}
{"agent":{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"<session>","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"1\n2\n3\n"}}}}}
{"client":{"method":"session/cancel","params":{"sessionId":"<session>"}}}
{"agent":{"jsonrpc":"2.0","id":3,"result":{"stopReason":"cancelled"}}}
